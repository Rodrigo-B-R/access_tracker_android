<?xml version="1.0" encoding="utf-8"?>
<!--
  Nada de esto se respalda en la nube ni se copia a otro telefono:
  la sesion (token), la copia del turno y la cola de checadas (lleva la ubicacion de la persona).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
        <exclude domain="file" path="datastore/cache_estado.preferences_pb" />
        <exclude domain="database" path="access_tracker.db" />
        <exclude domain="database" path="access_tracker.db-wal" />
        <exclude domain="database" path="access_tracker.db-shm" />
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="cola_checadas.xml" />
        <exclude domain="sharedpref" path="cache_estado.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
        <exclude domain="file" path="datastore/cache_estado.preferences_pb" />
        <exclude domain="database" path="access_tracker.db" />
        <exclude domain="database" path="access_tracker.db-wal" />
        <exclude domain="database" path="access_tracker.db-shm" />
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="cola_checadas.xml" />
        <exclude domain="sharedpref" path="cache_estado.xml" />
    </device-transfer>
</data-extraction-rules>
