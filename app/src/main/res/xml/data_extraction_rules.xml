<?xml version="1.0" encoding="utf-8"?>
<!-- La sesion (token) nunca se respalda en la nube ni se copia a otro telefono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="cola_checadas.xml" />
        <exclude domain="sharedpref" path="cache_estado.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="cola_checadas.xml" />
        <exclude domain="sharedpref" path="cache_estado.xml" />
    </device-transfer>
</data-extraction-rules>
